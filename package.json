{
  "name": "bridge-miniature-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A 60-second vertical miniature construction animation made with Remotion.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts BridgeMiniature out/bridge-miniature.mp4",
    "preview": "remotion still src/index.ts BridgeMiniature out/preview.png --frame=900"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
